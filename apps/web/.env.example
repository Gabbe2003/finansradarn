# Kopiera till .env.local och fyll i värden

# WordPress REST API — din WP-installation
NEXT_PUBLIC_WP_URL=https://cms.finansradarn.se

# WordPress Application Password (Settings → Users → Application Passwords)
WP_AUTH_USER=admin
WP_AUTH_PASSWORD=xxxx-xxxx-xxxx-xxxx

# SiteGround SSH
SITEGROUND_HOST=ssh.finansradarn.se
SITEGROUND_USER=root
SITEGROUND_SSH_KEY_PATH=~/.ssh/siteground_ed25519

# Hemlig nyckel för on-demand revalidation (generera med: openssl rand -hex 32)
REVALIDATION_SECRET=din-hemliga-nyckel-har
